#!/usr/bin/env bash
# 推送前：复检每个 outgoing 提交（policy --replay），再跑权威门禁 ci。
set -euo pipefail
export LC_ALL=C
root="$(git rev-parse --show-toplevel)"
input="$(mktemp "${TMPDIR:-/tmp}/xtask-pre-push.XXXXXX")"
trap 'rm -f "$input"' EXIT
cat >"$input"
for script in "$root"/.githooks/pre-push.d/*.sh; do
  [[ -e "$script" ]] || continue
  "$script" "$@" <"$input"
done
