#!/usr/bin/env bash
# 标题：emoji 中文类型(scope): 结果；正文：## 原因 / ## 影响 / ## 取舍。
set -euo pipefail
export LC_ALL=C
root="$(git rev-parse --show-toplevel)"
node "$root/tools/xtask.mjs" policy --message "$1"

for hook in "$root"/.githooks/commit-msg.d/*.sh; do
  [[ -e "$hook" ]] || continue
  if [[ ! -f "$hook" || ! -x "$hook" ]]; then
    echo "commit-msg: extension must be an executable regular file: $hook" >&2
    exit 1
  fi
  "$hook" "$1"
done
